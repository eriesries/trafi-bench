# --------------------------------------------------------------------
# Copy this file to `.env.local` and fill in the real values.
# `.env.local` is git-ignored — NEVER commit it.
# --------------------------------------------------------------------

# Supabase project URL (Project Settings → API → Project URL)
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co

# Supabase publishable / anon key (Project Settings → API → Project API keys)
# Used directly in the browser, so RLS policies are what protect your data.
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxx

# OpenAI API key, used for the Vision-based screenshot analysis.
# Create one at https://platform.openai.com/api-keys
VITE_OPENAI_API_KEY=sk-...

# Optional. Vision-capable OpenAI model. Defaults to `gpt-4o-mini`.
# Examples: gpt-4o-mini, gpt-4o, gpt-4.1-mini, gpt-4.1
VITE_OPENAI_MODEL=gpt-4o-mini
